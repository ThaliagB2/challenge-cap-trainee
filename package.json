{
    "name": "vet-clinic-service",
    "version": "0.0.1",
    "description": "A simple CAP project.",
    "private": true,
    "devDependencies": {
        "eslint-config-prettier": "^10.1.8",
        "mbt": "^1.2.18",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1"
    },
    "scripts": {
        "setup": "node scripts/setup-template.js",
        "setup:alt": "node scripts/setup.js",
        "bd": "npm-run-all clean build deploy",
        "clean": "rimraf mta_archives",
        "build": "mbt build --mtar vet-clinic-service.mtar",
        "build:cf": "npm-run-all build:cds build:apps",
        "build:cds": "cds build --production",
        "build:apps": "npm-run-all build:app-srv",
        "build:app-srv": "cd vet-clinic-service && yarn && yarn build:mta",
        "deploy": "cf deploy mta_archives/vet-clinic-service.mtar --retries 0",
        "undeploy": "cf undeploy vet-clinic-service --delete-services --delete-service-keys --delete-service-brokers"
    }
}
