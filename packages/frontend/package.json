{
    "name": "vet-clinic",
    "description": "vet-clinic frontend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "bd": "npm-run-all clean build deploy",
        "clean": "rimraf html5deployer/resources mta_archives",
        "build": "mbt build --mtar vet-clinic.mtar",
        "deploy": "cf deploy mta_archives/vet-clinic.mtar --retries 0",
        "undeploy": "cf undeploy vet-clinic --delete-services --delete-service-keys --delete-service-brokers",
        "clean:cache": "yarn cache clean"
    },
    "engines": {
        "node": "^20 || ^22"
    },
    "devDependencies": {
        "mbt": "^1.2.18",
        "rimraf": "^6.0.1"
    },
    "dependencies": {
        "npm-run-all": "^4.1.5"
    }
}
