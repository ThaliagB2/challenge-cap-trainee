{
    "name": "vet-clinic-service",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@cap-js/hana": "^2.2.0",
        "@sap-cloud-sdk/http-client": "^4.1.1",
        "@sap/cds": "^9.3.1",
        "@sap/textbundle": "^6.0.0",
        "@sap/xsenv": "^6.0.0",
        "@sap/xssec": "^4.9.2",
        "@sweet-monads/either": "^3.3.1",
        "date-fns": "^4.1.0",
        "exceljs": "^4.4.0",
        "express": "^4",
        "module-alias": "^2.2.3",
        "passport": "^0.7.0"
    },
    "devDependencies": {
        "@cap-js/cds-typer": "^0.37.0",
        "@cap-js/cds-types": "^0.14.0",
        "@cap-js/sqlite": "^2.0.2",
        "@eslint/js": "^9.35.0",
        "@types/express": "^4",
        "@types/module-alias": "^2.0.4",
        "@types/node": "^24.5.1",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "@vitest/coverage-v8": "3.1.3",
        "eslint": "^9.35.0",
        "eslint-plugin-prettier": "^5.5.4",
        "git-commit-msg-linter": "^5.0.8",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.44.0",
        "vitest": "3.1.3"
    },
    "scripts": {
        "build:mta": "yarn dev:generate-types && yarn build:ts",
        "build:ts": "tsc",
        "start": "cds-serve",
        "dev:build-db": "tsx ./src/main/scripts/populate-local-db.ts",
        "dev:generate-types": "cds-typer -c ./@cds-models ./src/main/routes",
        "dev:run-api": "NODE_ENV=dev cds-tsx serve --from ./src/main/routes --with-mocks --watch --in-memory?",
        "dev": "npm-run-all dev:build-db dev:generate-types dev:run-api",
        "test:unit": "vitest --dir test/unit || echo 'No unit tests found'",
        "test:coverage": "yarn dev:generate-types && vitest --coverage --run --silent",
        "lint": "eslint ."
    },
    "engines": {
        "node": "^20 || ^22"
    }
}
