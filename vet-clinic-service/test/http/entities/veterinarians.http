@baseUrl = http://localhost:4004/sample/Veterinarians
@dummyAuth = Basic ZHVtbXk6ZHVtbXk=
@vetId = 091bb664-e13c-457a-9b65-c633596b52f4

### Listar todos os veterinários
GET {{baseUrl}}/Veterinarians
Authorization: {{dummyAuth}}

### Buscar veterinário por ID
GET {{baseUrl}}/Veterinarians(id={{vetId}})
Authorization: {{dummyAuth}}

### Criar novo veterinário
POST {{baseUrl}}/Veterinarians
Content-Type: application/json
Authorization: {{dummyAuth}}

{
  "firstName": "Maria",
  "lastName": "Santos",
  "specialty": "Dentistry",
  "crmv": "CRMV99999"
}