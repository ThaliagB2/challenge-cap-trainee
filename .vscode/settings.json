{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always",
        "source.organizeImports": "always"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.indentSize": 4,
    "[javascript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[css]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[jsx]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true
}